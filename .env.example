# Backend settings for local development (`task dev`). Copy to .env and adjust.
# Every variable is explained in docs/ENVIRONMENT.md. Never commit .env.

NETOPOLOGY_ENV=development
NETOPOLOGY_LOG_LEVEL=debug
NETOPOLOGY_ADDR=:8080
# where the browser opens the app (the Next.js dev server proxies /api to this backend)
NETOPOLOGY_PUBLIC_URL=http://localhost:3000
# browsers accept Secure cookies on http://localhost, so this can stay true
NETOPOLOGY_COOKIE_SECURE=true

# app role: NOT superuser, row-level security applies
NETOPOLOGY_DATABASE_URL=postgres://netopology_app:app@localhost:5432/netopology?sslmode=disable
# schema owner: migrations only
NETOPOLOGY_MIGRATE_DATABASE_URL=postgres://netopology_owner:owner@localhost:5432/netopology?sslmode=disable
NETOPOLOGY_MIGRATE_ON_START=true

# 32 random bytes, base64: openssl rand -base64 32   (this one is for development only)
NETOPOLOGY_SECRET_KEY=ZGV2LW9ubHktc2VjcmV0LWtleS1jaGFuZ2UtbWUhISE=

NETOPOLOGY_SESSION_TTL=168h

# Google / Discord sign-in: enabled when both values are set.
# Redirect URI to register with the provider: $NETOPOLOGY_PUBLIC_URL/api/v1/auth/oauth/<google|discord>/callback
NETOPOLOGY_GOOGLE_CLIENT_ID=
NETOPOLOGY_GOOGLE_CLIENT_SECRET=
NETOPOLOGY_DISCORD_CLIENT_ID=
NETOPOLOGY_DISCORD_CLIENT_SECRET=

NETOPOLOGY_WORKER_CONCURRENCY=10

# Integration tests: a Postgres 18 SUPERUSER (creates throwaway databases). Matches compose.dev.yaml.
NETOPOLOGY_TEST_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
